# Copy this file to .env and paste your OpenAI API key.
# .env is gitignored so your key will never be committed.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE

# Outside editor model (recommended: gpt-6.1-sol for fast ablations; gpt-6.2-astra for flagship runs)
MWE_AGENT_MODEL=gpt-6.1-sol

# Reasoning effort for GPT-6 models: low, medium, high (low/medium keeps spend tight on a $20 budget)
MWE_REASONING_EFFORT=medium

# Safety caps for API spend per run
MWE_MAX_TURNS=16
MWE_MAX_EDITS=6
